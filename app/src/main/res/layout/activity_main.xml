<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="自动录音AI"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- 开始/停止按钮 -->
    <Button
        android:id="@+id/btn_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开始工作"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <!-- 状态显示 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击「开始工作」启动"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <!-- 录音时间显示 -->
    <TextView
        android:id="@+id/tv_recording_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <!-- 实时文字显示区域 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="实时通话内容："
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_realtime_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待通话开始..."
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#F5F5F5"/>

    </ScrollView>

    <!-- AI 总结区域 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI 总结："
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_ai_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="点击「停止工作」后显示总结"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#F0F8FF"/>

    </ScrollView>

    <!-- 底部按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_request_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="授予权限"
            android:visibility="gone"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="无障碍服务"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
