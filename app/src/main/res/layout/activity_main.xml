<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="自动录音AI"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- 开始/停止按钮 -->
    <Button
        android:id="@+id/btn_start"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开始监听"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btn_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="停止监听"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:enabled="false"/>

    <!-- 状态显示 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击「开始监听」启动服务"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"/>

    <!-- 录音时间显示 -->
    <TextView
        android:id="@+id/tv_recording_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <!-- 实时文字显示区域 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="实时通话内容："
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:id="@+id/scroll_realtime"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_realtime_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待通话开始..."
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#F5F5F5"/>

    </ScrollView>

    <!-- AI 总结区域 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI 总结："
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:id="@+id/scroll_summary"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通话结束后自动生成总结"
            android:textSize="14sp"
            android:padding="8dp"
            android:background="#F0F8FF"/>

    </ScrollView>

    <!-- 测试按钮 -->
    <Button
        android:id="@+id/btn_test_record"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="测试录音(5秒)"
        android:layout_gravity="center"/>

</LinearLayout>
